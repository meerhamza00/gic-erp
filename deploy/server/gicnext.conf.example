# GICNEXT server config. Lives at /opt/gicnext/gicnext.conf, chmod 600, owner gicnext.
# bootstrap.sh creates it from this template with a random DB_PASSWORD. Never commit it.

# Set by every deploy (remote-deploy.sh). Do not edit by hand.
GICNEXT_VERSION=

# Traefik (HTTPS on 80/443) runs only with this profile.
COMPOSE_PROFILES=proxy

# Free Let's Encrypt certificates are issued for every host in SITES_RULE.
LETSENCRYPT_EMAIL=you@example.com

# One Host() per client site. DNS for each must point at this server.
#   SITES_RULE=Host(`erp.example.com`) || Host(`acme.example.com`)
SITES_RULE=Host(`erp.example.com`)

# MariaDB root password. Generated by bootstrap.sh; needed to create new sites.
DB_PASSWORD=change-me

# Optional tuning
BACKUP_CRONSTRING=@every 6h
GUNICORN_WORKERS=2
