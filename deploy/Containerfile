# syntax=docker/dockerfile:1
# GICNEXT production image: Frappe + ERPNext + gic_erp, one image for every service.
#
# Adapted from frappe_docker images/layered/Containerfile (MIT, see resources/).
# Differences: Frappe and ERPNext are pinned to git tags (deploy/versions.conf), and
# gic_erp is copied from the build context (the exact commit CI tested), so no git token
# is ever passed into the build.
#
#   docker build -f deploy/Containerfile $(sed 's/^/--build-arg /' deploy/versions.conf ...) .
#   (CI: .github/workflows/image.yml)

ARG FRAPPE_BUILD_IMAGE=frappe/build:v15.125.0
ARG FRAPPE_BASE_IMAGE=frappe/base:v15.127.1

FROM ${FRAPPE_BUILD_IMAGE} AS builder

ARG FRAPPE_REF=v15.127.1
ARG ERPNEXT_REF=v15.125.0

USER frappe
WORKDIR /home/frappe

# Frappe + ERPNext: changes only when versions.conf changes, so this layer stays cached.
# hadolint ignore=DL3003
RUN bench init \
      --frappe-branch="${FRAPPE_REF}" \
      --no-procfile \
      --no-backups \
      --skip-redis-config-generation \
      /home/frappe/frappe-bench \
 && cd /home/frappe/frappe-bench \
 && bench get-app --branch="${ERPNEXT_REF}" erpnext

# gic_erp from the build context (see .dockerignore).
COPY --chown=frappe:frappe . /home/frappe/frappe-bench/apps/gic_erp

WORKDIR /home/frappe/frappe-bench
RUN ./env/bin/pip install --no-cache-dir -e apps/gic_erp \
 && (grep -qx gic_erp sites/apps.txt || printf "\ngic_erp\n" >> sites/apps.txt) \
 && sed -i "/^$/d" sites/apps.txt \
 && bench build --app gic_erp \
 && echo "{}" > sites/common_site_config.json \
 && find apps -mindepth 1 -path "*/.git" -prune -exec rm -rf {} + \
 && chmod -R g=u /home/frappe/frappe-bench

FROM ${FRAPPE_BASE_IMAGE} AS backend

ARG GICNEXT_VERSION=dev
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="GICNEXT" \
      org.opencontainers.image.description="GICNEXT ERP: Frappe + ERPNext v15 + gic_erp" \
      org.opencontainers.image.version="${GICNEXT_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/meerhamza00/gic-erp" \
      org.opencontainers.image.licenses="MIT"

USER frappe
COPY --from=builder --chown=frappe:0 /home/frappe/frappe-bench /home/frappe/frappe-bench
WORKDIR /home/frappe/frappe-bench

# Built assets live in the image layer; entrypoint.sh links them into the sites volume.
RUN chmod g=u /home/frappe/frappe-bench \
 && cp -r sites/assets assets \
 && rm -rf sites/assets

VOLUME ["/home/frappe/frappe-bench/sites", "/home/frappe/frappe-bench/logs"]

USER root
COPY deploy/resources/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY deploy/resources/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["start.sh"]
