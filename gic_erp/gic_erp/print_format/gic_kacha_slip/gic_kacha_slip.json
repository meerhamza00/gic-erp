 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n\t.gic-slip { font-family: \"Plus Jakarta Sans\", Arial, sans-serif; font-size: 11px; color: #334155; max-width: 140mm; margin: 0 auto; }\n\t.gic-slip .co { font-size: 15px; font-weight: 800; color: #1C119C; text-align: center; }\n\t.gic-slip .memo { text-align: center; font-weight: 800; letter-spacing: 1.5px; margin: 6px 0 2px; color: #0F172A; border-top: 1px dashed #94A3B8; border-bottom: 1px dashed #94A3B8; padding: 3px 0; }\n\t.gic-slip .urdu { text-align: center; direction: rtl; font-size: 11px; color: #64748B; margin-bottom: 6px; }\n\t.gic-slip .meta td { padding: 1px 0; }\n\t.gic-slip table { width: 100%; border-collapse: collapse; }\n\t.gic-slip .items th { text-align: left; border-bottom: 1px solid #0F172A; padding: 3px 2px; font-weight: 700; }\n\t.gic-slip .items td { padding: 3px 2px; border-bottom: 1px dotted #E2E8F0; vertical-align: top; }\n\t.gic-slip .r { text-align: right; }\n\t.gic-slip .totals td { padding: 2px; }\n\t.gic-slip .grand td { font-weight: 800; font-size: 13px; border-top: 1px solid #0F172A; }\n\t.gic-slip .note { margin-top: 8px; font-size: 9px; color: #64748B; text-align: center; }\n\t.gic-slip .draft { text-align: center; color: #B91C1C; font-weight: 800; }\n</style>\n<div class=\"gic-slip\">\n\t<div class=\"co\">{{ doc.company }}</div>\n\t<div class=\"memo\">ESTIMATE / DELIVERY MEMO</div>\n\t<div class=\"urdu\">تخمینہ / ڈلیوری میمو</div>\n\t{% if doc.docstatus == 0 %}<div class=\"draft\">DRAFT</div>{% endif %}\n\t{% if doc.docstatus == 2 %}<div class=\"draft\">CANCELLED</div>{% endif %}\n\t<table class=\"meta\">\n\t\t<tr><td>Memo #</td><td class=\"r\"><b>{{ doc.name }}</b></td></tr>\n\t\t<tr><td>Date</td><td class=\"r\">{{ doc.get_formatted(\"posting_date\") }}</td></tr>\n\t\t<tr><td>Customer</td><td class=\"r\"><b>{{ doc.customer_name or doc.customer }}</b></td></tr>\n\t\t{% if doc.contact_mobile %}<tr><td>Mobile</td><td class=\"r\">{{ doc.contact_mobile }}</td></tr>{% endif %}\n\t</table>\n\t<table class=\"items\" style=\"margin-top: 6px;\">\n\t\t<tr><th>Item</th><th class=\"r\">Qty</th><th class=\"r\">Rate</th><th class=\"r\">Amount</th></tr>\n\t\t{% for row in doc.items %}\n\t\t<tr>\n\t\t\t<td>{{ row.item_name or row.item_code }}</td>\n\t\t\t<td class=\"r\">{{ row.get_formatted(\"qty\") }} {{ row.uom or \"\" }}</td>\n\t\t\t<td class=\"r\">{{ row.get_formatted(\"rate\", doc) }}</td>\n\t\t\t<td class=\"r\">{{ row.get_formatted(\"amount\", doc) }}</td>\n\t\t</tr>\n\t\t{% endfor %}\n\t</table>\n\t<table class=\"totals\" style=\"margin-top: 4px;\">\n\t\t{% if doc.discount_amount %}\n\t\t<tr><td>Total</td><td class=\"r\">{{ doc.get_formatted(\"total\") }}</td></tr>\n\t\t<tr><td>Discount</td><td class=\"r\">- {{ doc.get_formatted(\"discount_amount\") }}</td></tr>\n\t\t{% endif %}\n\t\t<tr class=\"grand\"><td>Total Amount</td><td class=\"r\">{{ doc.get_formatted(\"rounded_total\" if doc.rounded_total else \"grand_total\") }}</td></tr>\n\t\t{% if doc.docstatus == 1 %}\n\t\t<tr><td>Paid</td><td class=\"r\">{{ frappe.utils.fmt_money((doc.rounded_total or doc.grand_total) - doc.outstanding_amount, currency=doc.currency) }}</td></tr>\n\t\t<tr><td><b>Balance</b></td><td class=\"r\"><b>{{ doc.get_formatted(\"outstanding_amount\") }}</b></td></tr>\n\t\t{% endif %}\n\t</table>\n\t<div class=\"note\">\n\t\tEstimate / delivery memo. Not a sales tax invoice.<br>\n\t\tPowered by GICNEXT\n\t</div>\n</div>\n",
 "idx": 0,
 "line_breaks": 0,
